{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "AUTHORED by CyCom from the NIC IRP e-Invoice API v1.1 field specification and its published sample request (Pin integer, Stcd state code). NOT the NIC-hosted schema file: that file could not be retrieved (geo-restricted host) and the GSP-mirrored copy diverges from what the IRP accepts (State vs Stcd, string Pin, top-level properties outside 'properties'). Covers the subset CyCom emits, strictly (additionalProperties false).",
  "title": "GST e-Invoice (INV-01) v1.1 -- IRP GenerateIRN request",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version", "TranDtls", "DocDtls", "SellerDtls", "BuyerDtls", "ItemList", "ValDtls"],
  "definitions": {
    "gstin": {"type": "string", "pattern": "^[0-9]{2}[0-9A-Z]{13}$"},
    "stcd": {"type": "string", "pattern": "^([0-9]{1,2}|96|97)$"},
    "pin": {"type": "integer", "minimum": 100000, "maximum": 999999},
    "date": {"type": "string", "pattern": "^[0-3][0-9]/[0-1][0-9]/20[0-9]{2}$"},
    "amount": {"type": "number", "minimum": 0, "maximum": 99999999999999.99},
    "party": {
      "type": "object",
      "properties": {
        "LglNm": {"type": "string", "minLength": 3, "maxLength": 100},
        "TrdNm": {"type": "string", "minLength": 3, "maxLength": 100},
        "Addr1": {"type": "string", "minLength": 1, "maxLength": 100},
        "Addr2": {"type": "string", "minLength": 3, "maxLength": 100},
        "Loc": {"type": "string", "minLength": 3, "maxLength": 100},
        "Pin": {"$ref": "#/definitions/pin"},
        "Stcd": {"$ref": "#/definitions/stcd"},
        "Ph": {"type": "string", "minLength": 6, "maxLength": 12},
        "Em": {"type": "string", "minLength": 6, "maxLength": 100}
      }
    }
  },
  "properties": {
    "Version": {"const": "1.1"},
    "TranDtls": {
      "type": "object", "additionalProperties": false, "required": ["TaxSch", "SupTyp"],
      "properties": {
        "TaxSch": {"const": "GST"},
        "SupTyp": {"enum": ["B2B", "SEZWP", "SEZWOP", "EXPWP", "EXPWOP", "DEXP"]},
        "RegRev": {"enum": ["Y", "N"]},
        "EcmGstin": {"type": ["string", "null"]},
        "IgstOnIntra": {"enum": ["Y", "N"]}
      }
    },
    "DocDtls": {
      "type": "object", "additionalProperties": false, "required": ["Typ", "No", "Dt"],
      "properties": {
        "Typ": {"enum": ["INV", "CRN", "DBN"]},
        "No": {"type": "string", "pattern": "^([A-Z1-9]{1}[A-Z0-9/-]{0,15})$"},
        "Dt": {"$ref": "#/definitions/date"}
      }
    },
    "SellerDtls": {
      "allOf": [{"$ref": "#/definitions/party"}],
      "type": "object", "required": ["Gstin", "LglNm", "Addr1", "Loc", "Pin", "Stcd"],
      "properties": {"Gstin": {"$ref": "#/definitions/gstin"}},
      "propertyNames": {"enum": ["Gstin", "LglNm", "TrdNm", "Addr1", "Addr2", "Loc", "Pin", "Stcd", "Ph", "Em"]}
    },
    "BuyerDtls": {
      "allOf": [{"$ref": "#/definitions/party"}],
      "type": "object", "required": ["Gstin", "LglNm", "Pos", "Addr1", "Loc", "Stcd"],
      "properties": {
        "Gstin": {"type": "string", "pattern": "^(([0-9]{2}[0-9A-Z]{13})|URP)$"},
        "Pos": {"$ref": "#/definitions/stcd"}
      },
      "propertyNames": {"enum": ["Gstin", "LglNm", "TrdNm", "Pos", "Addr1", "Addr2", "Loc", "Pin", "Stcd", "Ph", "Em"]}
    },
    "ItemList": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["SlNo", "IsServc", "HsnCd", "UnitPrice", "TotAmt", "AssAmt", "GstRt", "TotItemVal"],
        "properties": {
          "SlNo": {"type": "string", "pattern": "^[0-9]{1,6}$"},
          "PrdDesc": {"type": "string", "minLength": 3, "maxLength": 300},
          "IsServc": {"enum": ["Y", "N"]},
          "HsnCd": {"type": "string", "pattern": "^([0-9]{4}|[0-9]{6}|[0-9]{8})$"},
          "Qty": {"type": "number", "minimum": 0, "maximum": 9999999999.999},
          "Unit": {"type": "string", "minLength": 3, "maxLength": 8},
          "UnitPrice": {"$ref": "#/definitions/amount"},
          "TotAmt": {"$ref": "#/definitions/amount"},
          "Discount": {"$ref": "#/definitions/amount"},
          "AssAmt": {"$ref": "#/definitions/amount"},
          "GstRt": {"enum": [0, 0.1, 0.25, 1, 1.5, 3, 5, 6, 7.5, 12, 18, 28, 40]},
          "IgstAmt": {"$ref": "#/definitions/amount"},
          "CgstAmt": {"$ref": "#/definitions/amount"},
          "SgstAmt": {"$ref": "#/definitions/amount"},
          "TotItemVal": {"$ref": "#/definitions/amount"}
        }
      }
    },
    "ValDtls": {
      "type": "object", "additionalProperties": false, "required": ["AssVal", "TotInvVal"],
      "properties": {
        "AssVal": {"$ref": "#/definitions/amount"},
        "CgstVal": {"$ref": "#/definitions/amount"},
        "SgstVal": {"$ref": "#/definitions/amount"},
        "IgstVal": {"$ref": "#/definitions/amount"},
        "RndOffAmt": {"type": "number", "minimum": -99.99, "maximum": 99.99},
        "TotInvVal": {"$ref": "#/definitions/amount"},
        "TotInvValFc": {"$ref": "#/definitions/amount"}
      }
    },
    "RefDtls": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "InvRm": {"type": "string", "minLength": 3, "maxLength": 100},
        "PrecDocDtls": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["InvNo", "InvDt"],
            "properties": {
              "InvNo": {"type": "string", "pattern": "^([A-Z1-9]{1}[A-Z0-9/-]{0,15})$"},
              "InvDt": {"$ref": "#/definitions/date"},
              "OthRefNo": {"type": "string", "maxLength": 20}
            }
          }
        }
      }
    },
    "ExpDtls": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ForCur": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "CntCode": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "Port": {"type": "string", "maxLength": 10},
        "RefClm": {"enum": ["Y", "N"]}
      }
    },
    "PayDtls": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "Nm": {"type": "string", "maxLength": 100},
        "AccDet": {"type": "string", "maxLength": 18},
        "Mode": {"type": "string", "maxLength": 18},
        "FinInsBr": {"type": "string", "maxLength": 11},
        "CrDay": {"type": "integer", "minimum": 0, "maximum": 9999}
      }
    }
  }
}
