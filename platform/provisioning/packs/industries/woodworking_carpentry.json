  "ai_knowledge": {
    "domain_notes": "Sheet-stock yield decides margin on bespoke work more than the labour rate does -- poor cutting layout turns a profitable job into a loss through waste alone. Nothing should be cut before the design is signed off, since a bespoke piece can't be resold if the client changes their mind after the fact.",
    "starter_prompts": [
      "Show material yield and waste by job.",
      "Which jobs are awaiting design approval?",
      "Show install schedule for next week.",
      "What is job margin against quote this month?"
    ]
  }
