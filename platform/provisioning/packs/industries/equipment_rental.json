      },
      {
        "code": "4690",
        "name": "Hire Revenue",
        "account_type": "income",
        "parent": "4200"
      },
      {
        "code": "4700",
        "name": "Damage & Late Fees",
        "account_type": "income",
        "parent": "4300"
      },
      {
        "code": "5480",
        "name": "Fleet Maintenance",
        "account_type": "expense",
        "parent": "5000"
      },
      {
        "code": "5490",
        "name": "Fleet Depreciation",
        "account_type": "expense",
        "parent": "5000"
      }
    ]
  },
  "industry_fields": {
    "asset": [
      "asset_tag",
      "purchase_date",
      "purchase_cost",
      "daily_rate",
      "weekly_rate",
      "next_service_due",
      "condition"
    ],
    "hire": [
      "out_date",
      "due_date",
      "returned_date",
      "condition_out",
      "condition_in",
      "deposit"
    ]
  },
  "dashboards": [
    "Fleet Utilization",
    "On Hire Now",
    "Overdue Returns",
    "Service Due"
  ],
  "reports": [
    "Utilization by Asset",
    "Overdue Return Report",
    "Damage Claim Log",
    "Revenue per Asset",
    "Service Schedule"
  ],
  "doc_templates": [
    "Hire Agreement",
    "Condition Report",
    "Off-hire Note",
    "Damage Invoice"
  ],
  "import_templates": [
    {
      "entity": "assets",
      "columns": [
        "asset_tag",
        "name",
        "category",
        "purchase_cost",
        "daily_rate",
        "weekly_rate"
      ]
    },
    {
      "entity": "hires",
      "columns": [
        "hirer",
        "asset_tag",
        "out_date",
        "due_date",
        "rate",
        "deposit"
      ]
    }
  ],
  "ai_knowledge": {
    "domain_notes": "Utilization is the entire business model: an asset sitting in the yard still depreciates and still has capital tied up in it. Revenue per asset against purchase cost tells you what to buy more of and what to sell. Condition-out versus condition-in is what makes a damage charge defensible rather than a dispute.",
    "starter_prompts": [
      "Show fleet utilization by category.",
      "Which hires are overdue for return?",
      "Show revenue per asset against purchase cost.",
      "List equipment due for service."
    ]
  }
}
