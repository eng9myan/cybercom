{
  "key": "equipment_rental",
  "name": "Equipment & Tool Rental",
  "version": "1.0",
  "description": "Rental fleet on hire cycles: availability, damage and late fees, servicing between hires, utilization economics.",
  "department_pack_keys": [
    "finance",
    "pos",
    "inventory",
    "maintenance"
  ],
  "recommended_ops": [
    "rents_assets",
    "retail_pos"
  ],
  "terminology": {
    "customer": "Hirer",
    "sale_order": "Hire Agreement"
  },
  "default_config": {
    "roles": [
      {
        "name": "Depot Manager",
        "description": "Owns fleet, pricing and damage claims."
      },
      {
        "name": "Hire Desk",
        "description": "Books hires and takes deposits."
      },
      {
        "name": "Fitter",
        "description": "Services and repairs returned equipment."
      }
    ]
  },
  "approval_matrix": [
    {
      "document_type": "damage_claim",
      "name": "Damage Charge",
      "tiers": [
        {
          "min": 0,
          "max": 500,
          "role": "Hire Desk"
        },
        {
          "min": 500,
          "max": null,
          "role": "Depot Manager"
        }
      ]
    },
    {
      "document_type": "discount",
      "name": "Hire Rate Discount",
      "tiers": [
        {
          "min": 0,
          "max": 15,
          "role": "Hire Desk"
        },
        {
          "min": 15,
          "max": null,
          "role": "Depot Manager"
        }
      ]
    },
    {
      "document_type": "write_off",
      "name": "Fleet Asset Write-off",
      "tiers": [
        {
          "min": 0,
          "max": null,
          "role": "Depot Manager"
        }
      ]
    }
  ],
  "categories": [
    "Access",
    "Powered Tools",
    "Groundcare",
    "Generators",
    "Heating",
    "Consumables",
    "Transport"
  ],
  "accounting_mappings": {
    "extra_accounts": [
      {
        "code": "2193",
        "name": "Hire Deposits",
        "account_type": "liability",
