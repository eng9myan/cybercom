  "ai_knowledge": {
    "domain_notes": "Fees are billed by design stage, not by time alone -- a stage isn't complete (and billable) until the principal signs it off, which is a real quality gate, not paperwork. Sub-consultant fees pass through the practice's books but belong to a different budget line than the design fee itself, or margin looks wrong. Planning deadlines are statutory, not negotiable, and belong on the same dashboard as WIP.",
    "starter_prompts": [
      "Show WIP by commission and design stage.",
      "Which commissions have a planning deadline in the next 30 days?",
      "Show sub-consultant spend by commission.",
      "List drawings awaiting issue for Technical Design stage."
    ]
  }
