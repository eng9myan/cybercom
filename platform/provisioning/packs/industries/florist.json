  "ai_knowledge": {
    "domain_notes": "Stem life is measured in days and demand is spiky around occasions (Valentine's, Mother's Day) -- buying is a forecast bet, and unsold stems are a total loss. Delivery windows are a service promise: a late funeral tribute is an unrecoverable failure, not a late parcel.",
    "starter_prompts": [
      "Show deliveries scheduled for today by window.",
      "What is stem wastage this week?",
      "Compare Valentine's sales to last year.",
      "List stock older than its stem life."
    ]
  }
