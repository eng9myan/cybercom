      "warranty_years",
      "efficiency_percent"
    ]
  },
  "dashboards": [
    "Pipeline to Install",
    "Installs Awaiting Commissioning",
    "Equipment Stock",
    "Deposit Liability"
  ],
  "reports": [
    "Install Pipeline",
    "Commissioning Status",
    "Serial & Warranty Register",
    "Generation vs Estimate",
    "Margin per kWp"
  ],
  "doc_templates": [
    "Survey Report",
    "System Design",
    "Installation Quotation",
    "Commissioning Certificate",
    "Warranty Document"
  ],
  "import_templates": [
    {
      "entity": "clients",
      "columns": [
        "name",
        "site_address",
        "contact_email",
        "phone"
      ]
    },
    {
      "entity": "installations",
      "columns": [
        "client",
        "site_address",
        "system_kwp",
        "panel_count",
        "survey_date",
        "total_price"
      ]
    }
  ],
  "ai_knowledge": {
    "domain_notes": "The quoted annual generation figure is effectively a performance promise -- underestimating shading at survey turns into a complaint years later, so survey quality is a warranty control. Panel and inverter serials must be captured for manufacturer warranty claims, which can run 10-25 years, far longer than most job records are usually kept. Margin is best tracked per kWp, not per job.",
    "starter_prompts": [
      "Show installs awaiting commissioning.",
      "What is margin per kWp by system size?",
      "List installations where actual generation is below estimate.",
      "Show equipment stock against the install pipeline."
    ]
  }
}
