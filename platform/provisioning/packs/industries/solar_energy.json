{
  "key": "solar_energy",
  "name": "Solar Energy Installer",
  "version": "1.0",
  "description": "Survey-to-commissioning installs: system design, panel and inverter serials, financing/subsidy, generation warranty.",
  "department_pack_keys": [
    "finance",
    "sales",
    "projects",
    "inventory",
    "procurement"
  ],
  "recommended_ops": [
    "manages_projects",
    "buys_products",
    "provides_services"
  ],
  "terminology": {
    "customer": "Client",
    "sale_order": "Installation"
  },
  "default_config": {
    "roles": [
      {
        "name": "Installation Manager",
        "description": "Owns design sign-off, scheduling and commissioning."
      },
      {
        "name": "Surveyor",
        "description": "Surveys the roof and sizes the system."
      },
      {
        "name": "Installer",
        "description": "Fits panels and inverters."
      },
      {
        "name": "General Manager",
        "description": "Final approval authority for high-value documents across the business."
      }
    ]
  },
  "approval_matrix": [
    {
      "document_type": "system_design",
      "name": "System Design Sign-off",
      "tiers": [
        {
          "min": 0,
          "max": null,
          "role": "Installation Manager"
        }
      ]
    },
    {
      "document_type": "quotation",
      "name": "Installation Quotation",
      "tiers": [
        {
          "min": 0,
          "max": 30000,
          "role": "Installation Manager"
        },
        {
          "min": 30000,
          "max": null,
          "role": "General Manager"
        }
      ]
    },
    {
      "document_type": "commissioning",
      "name": "Commissioning Certificate",
      "tiers": [
        {
          "min": 0,
          "max": null,
          "role": "Installation Manager"
        }
      ]
    }
  ],
  "categories": [
    "Panels",
    "Inverters",
    "Batteries",
    "Mounting",
    "Installation Labour",
    "Maintenance",
    "Monitoring"
  ],
  "accounting_mappings": {
    "extra_accounts": [
      {
        "code": "2192",
        "name": "Customer Deposits (Installations)",
        "account_type": "liability",
        "parent": "2100"
      },
      {
        "code": "4670",
        "name": "Installation Revenue",
        "account_type": "income",
        "parent": "4100"
      },
      {
        "code": "4680",
        "name": "Monitoring & Maintenance Revenue",
        "account_type": "income",
        "parent": "4200"
      },
      {
        "code": "5470",
        "name": "Panels & Equipment Cost",
        "account_type": "expense",
        "parent": "5100"
