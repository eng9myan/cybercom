  "ai_knowledge": {
    "domain_notes": "The shoot is one day; the edit backlog is the business. Turnaround time drives referrals more than price does. Licensing is separate revenue from the shoot fee -- a commercial client buying usage rights is a different sale from the session, and conflating them leaves money on the table.",
    "starter_prompts": [
      "Show shoots booked in the next 30 days.",
      "What is the current edit backlog by photographer?",
      "Show package profitability.",
      "List shoots with outstanding deposits."
    ]
  }
