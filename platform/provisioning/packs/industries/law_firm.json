  ],
  "ai_knowledge": {
    "domain_notes": "Client trust money is legally not firm revenue -- it must sit in a separate trust account and a matching trust liability, and never be recognized as income until billed against. The trust account and trust liability must reconcile to the penny; a mismatch is a bar-complaint-level event, not an accounting nit. Conflict checks belong at matter opening, before any work is logged.",
    "starter_prompts": [
      "Show unbilled WIP by matter older than 60 days.",
      "Which matters are over their budget hours?",
      "Show trust balances by client.",
      "List matters with a statutory deadline in the next 14 days.",
      "What is realization rate by partner this quarter?"
    ]
  }
}
