  "import_templates": [
    {
      "entity": "patients",
      "columns": [
        "full_name",
        "date_of_birth",
        "phone",
        "last_test_date"
      ]
    },
    {
      "entity": "products",
      "columns": [
        "sku",
        "name",
        "category",
        "cost",
        "retail_price",
        "frame_size"
      ]
    }
  ],
  "ai_knowledge": {
    "domain_notes": "A prescription has a legal expiry and belongs to the patient -- they can take it elsewhere, which makes dispense conversion (tests that turn into glasses) the number that matters. Two-year recall cycles are predictable, recurring revenue that only materialises if someone actually sends the reminder.",
    "starter_prompts": [
      "Who is due a recall in the next 60 days?",
      "Show dispense conversion rate this month.",
      "List lab orders overdue from the supplier.",
      "Show revenue split between tests and dispensing."
    ]
  }
}
