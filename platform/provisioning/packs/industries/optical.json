{
  "key": "optical",
  "name": "Optical & Eyewear",
  "version": "1.0",
  "description": "Sight tests, prescription-driven lens fitting, frame retail, lab orders and recall cycles.",
  "department_pack_keys": [
    "finance",
    "pos",
    "inventory",
    "hr"
