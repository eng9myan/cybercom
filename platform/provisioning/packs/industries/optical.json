      "tiers": [
        {
          "min": 0,
          "max": null,
          "role": "Optometrist"
        }
      ]
    },
    {
      "document_type": "lab_order",
      "name": "Lens Lab Order",
      "tiers": [
        {
          "min": 0,
          "max": null,
          "role": "Dispensing Optician"
        }
      ]
    },
    {
      "document_type": "discount",
      "name": "Dispense Discount",
      "tiers": [
        {
          "min": 0,
          "max": 15,
          "role": "Dispensing Optician"
        },
        {
          "min": 15,
          "max": null,
          "role": "Practice Manager"
        }
      ]
    }
  ],
  "categories": [
