  "ai_knowledge": {
    "domain_notes": "Margin lives in food cost percentage and guaranteed guest numbers -- catering for 200 when 150 turn up is a loss the client should contract to cover. Allergen data on every recipe is a safety requirement, not a nice-to-have. Hired equipment that never comes back is pure silent loss; track it out and in.",
    "starter_prompts": [
      "Show food cost percentage by order this month.",
      "Which orders are scheduled next week?",
      "Show per-head margin by menu.",
      "List equipment still out after the event date."
    ]
  }
