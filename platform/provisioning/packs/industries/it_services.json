        "client",
        "asset_tag",
        "model",
        "serial",
        "warranty_end"
      ]
    }
  ],
  "ai_knowledge": {
    "domain_notes": "Two very different margin profiles live in one business: recurring managed services (high margin, predictable) and hardware resale (thin margin, lumpy). Keep them on separate revenue accounts or blended margin will hide whether the recurring base is actually growing. SLA clocks should pause on customer-hold, or breach stats punish the desk for the client's delay.",
    "starter_prompts": [
      "Show SLA compliance by client this month.",
      "Which contracts renew in the next 60 days?",
      "Show recurring revenue vs hardware revenue.",
      "List tickets breaching SLA right now."
    ]
  }
