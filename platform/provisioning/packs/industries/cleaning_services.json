  "ai_knowledge": {
    "domain_notes": "Margin is hours: a contract priced on two hours a visit that actually takes three is loss-making from day one and nobody notices for months. Track actual hours against contracted hours per site. Inspection scores are the early warning for contract loss, well before the cancellation email.",
    "starter_prompts": [
      "Show contract margin by site.",
      "Which sites are over their contracted hours?",
      "Show inspection scores below target.",
      "What is consumable cost per site this month?"
    ]
