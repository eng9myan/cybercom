  "doc_templates": [
    "Membership Agreement",
    "Booking Confirmation",
    "Deposit Receipt",
    "Monthly Invoice"
  ],
  "import_templates": [
    {
      "entity": "members",
      "columns": [
        "company_name",
        "contact_name",
        "plan",
        "desk_number",
        "start_date"
      ]
    },
    {
      "entity": "rooms",
      "columns": [
        "name",
        "capacity",
        "hourly_rate",
        "floor"
      ]
    }
  ],
  "ai_knowledge": {
    "domain_notes": "Occupancy is the whole business model -- an unsold desk-day cannot be recovered. Included meeting-room credits should net off before overage is charged, otherwise members are double-billed for what their plan already covers. Deposits are refundable liabilities, never revenue.",
    "starter_prompts": [
      "What is desk occupancy this month?",
      "Show meeting room utilization by room.",
      "Which members exceeded their meeting credits?",
      "List contracts ending in 60 days."
    ]
  }
