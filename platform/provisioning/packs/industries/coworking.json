      {
        "name": "Front of House",
        "description": "Handles day passes and bookings."
      }
    ]
  },
  "approval_matrix": [
    {
      "document_type": "membership",
      "name": "Membership Contract",
      "tiers": [
        {
          "min": 0,
          "max": null,
          "role": "Community Manager"
        }
      ]
    },
    {
      "document_type": "discount",
      "name": "Membership Discount",
      "tiers": [
        {
          "min": 0,
          "max": 10,
          "role": "Front of House"
        },
        {
          "min": 10,
          "max": null,
          "role": "Community Manager"
        }
      ]
    },
    {
      "document_type": "refund",
      "name": "Refund / Credit Note",
      "tiers": [
        {
          "min": 0,
          "max": null,
          "role": "Community Manager"
        }
      ]
    }
