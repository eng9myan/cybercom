  ],
  "ai_knowledge": {
    "domain_notes": "A safety certificate is a legal instrument tied to a named, currently-certified electrician -- issuing one under an expired qualification is a compliance failure, not a clerical error, so certification expiry needs its own alert independent of job scheduling. Apprentices can attend jobs but can't self-certify, which the job record should enforce, not just the office remember.",
    "starter_prompts": [
      "Which electricians have certifications expiring in 60 days?",
      "Show today's jobs by engineer.",
      "List certificates issued this month.",
      "Show job costing against quote."
    ]
  }
