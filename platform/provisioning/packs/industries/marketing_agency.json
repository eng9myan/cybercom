  "import_templates": [
    {
      "entity": "clients",
      "columns": [
        "name",
        "industry",
        "contact_email",
        "retainer_amount"
      ]
    },
    {
      "entity": "campaigns",
      "columns": [
        "client",
        "name",
        "channel",
        "budget",
        "start_date",
        "end_date"
      ]
    }
  ],
  "ai_knowledge": {
    "domain_notes": "Media spend passed through to clients is not agency revenue -- booking it gross inflates the top line and distorts margin. Keep pass-through cost and agency fee on separate accounts so client profitability is measured on fee, not on turnover. Retainer burn needs watching: unbilled overservice is the classic agency leak.",
    "starter_prompts": [
      "Show campaign profitability by client.",
      "Which retainers are overserviced this month?",
      "Show media spend vs budget by campaign.",
      "List campaigns ending in the next 2 weeks."
    ]
  }
