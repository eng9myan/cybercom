# Copy to .env.keycloak and fill in. NEVER commit the filled file.
# Used by docker-compose.keycloak-prod.yml.

# Public hostname the reverse proxy serves Keycloak on (no scheme).
KC_HOSTNAME=auth.cy-com.com

# Keycloak's own Postgres (dedicated — do NOT reuse the app DB).
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-long-random

# First-boot admin. Log in once, create a real admin, then rotate/disable this.
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change-me-long-random
