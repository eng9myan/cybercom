# Copy to .env and fill in. Used by docker compose.

# --- Core (required in production) ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
ALLOWED_HOSTS=your.school.domain,api
CORS_ALLOWED_ORIGINS=https://your.school.domain

# --- Database ---
DB_NAME=cyed
DB_USER=postgres
DB_PASSWORD=change-me

# --- AI (optional; off = deterministic grounded fallback) ---
CYED_LLM_ENABLED=
CYED_ANTHROPIC_API_KEY=

# --- Provider seams (optional) ---
CYED_OCR_ENABLED=
CYED_STT_ENABLED=
CYED_NOTIFY_SMS_ENABLED=
CYED_NOTIFY_WHATSAPP_ENABLED=

# --- Optional CyCom ERP reuse (leave blank to use CyEd's native ERP) ---
CYED_CYCOM_URL=

# --- Identity (production: point at your Keycloak/OIDC realm) ---
CYIDENTITY_ISSUER=https://id.your.domain/realms/cybercom
