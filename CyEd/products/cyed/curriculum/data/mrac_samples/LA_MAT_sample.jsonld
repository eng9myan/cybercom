     }
    ],
    "http://purl.org/dc/terms/description": [
     {
      "@language": "en-au",
      "@value": "investigating and interpreting logarithmic scales used in real-world contexts; for example, Richter, decibel and sensitivity scales or growth in investments, timescales and the spread of micro-organisms and disease and describing reasons for choosing to use a logarithmic scale rather than a linear scale"
     }
    ],
