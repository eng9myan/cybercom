    "http://purl.org/dc/terms/description": [
     {
      "@language": "en-au",
      "@value": "identifying and interpreting data representations (charts and graphs) that use logarithmic scales and discussing when it is appropriate to use this type of scale and when it is not appropriate; for example, graphs representing percentage change, a wide range of values or exponential growth"
     }
