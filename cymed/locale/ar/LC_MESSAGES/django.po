msgstr "فتح واجهة الاعتماد البرمجية"

msgid ""
"Your patient roster with active conditions and care plans from "
"/api/v1/clinical/."
msgstr "قائمة مرضاك مع الحالات النشطة وخطط الرعاية من ‎/api/v1/clinical/‎."

msgid "Calendar and availability from /api/v1/scheduling/."
msgstr "التقويم والإتاحة من ‎/api/v1/scheduling/‎."

msgid ""
"Lab, imaging and pharmacy orders with results from /api/v1/lab/, "
"/api/v1/imaging/, /api/v1/pharmacy/."
msgstr ""
"طلبات المختبر والأشعة والصيدلية مع النتائج من ‎/api/v1/lab/‎ "
"و‎/api/v1/imaging/‎ و‎/api/v1/pharmacy/‎."

msgid "Virtual consultations from /api/v1/clinic/telemedicine/."
msgstr "الاستشارات الافتراضية من ‎/api/v1/clinic/telemedicine/‎."
