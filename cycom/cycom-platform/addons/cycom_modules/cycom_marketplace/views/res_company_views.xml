<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_marketplace" model="ir.ui.view">
        <field name="name">res.company.form.cymart.marketplace</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="CyMart Marketplace" name="cymart_marketplace">
                    <field name="operates_customer_facing_store"/>
                    <field name="marketplace_eligible"/>
                    <field name="marketplace_agreement_signed" readonly="1"/>
                    <field name="marketplace_agreement_signed_at" readonly="1"/>
                    <field name="marketplace_status"/>
                    <field name="merchant_verification_status"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
