<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_marketplace" model="ir.ui.view">
        <field name="name">pos.config.form.cymart.marketplace</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="CyMart Marketplace" name="cymart_marketplace">
                    <field name="marketplace_enabled"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
